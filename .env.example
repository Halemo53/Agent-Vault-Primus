# ---- Server-only (never exposed to the browser) ----
# Primus developer credentials from https://dev.primuslabs.xyz (create a project -> App ID / App Secret)
PRIMUS_APP_ID=
# Used server-side to sign zkTLS attestation requests. Never prefix with VITE_.
PRIMUS_APP_SECRET=

# ---- Contract deployment with Foundry (contracts/) ----
# RPC for Base Sepolia (chain id 84532). Public endpoint works for light use.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Private key of the deployer/owner wallet (testnet only!)
DEPLOYER_PRIVATE_KEY=
# Wallet address of the AI agent that may call executePayment
AGENT_ADDRESS=
# Optional: for `forge verify-contract` on BaseScan
BASESCAN_API_KEY=
